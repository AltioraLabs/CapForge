# CapForge Environment Configuration
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.

# =============================================================================
# CORE PATHS
# =============================================================================
CAPFORGE_BASE_DIR=/app
CAPFORGE_DATA_DIR=/app/data
CAPFORGE_DB_PATH=/app/data/capforge.db
CAPFORGE_AUTH_DB_PATH=/app/data/capforge_auth.db
CAPFORGE_CAPABILITIES_DIR=/app/capabilities

# =============================================================================
# SERVER
# =============================================================================
CAPFORGE_API_HOST=0.0.0.0
CAPFORGE_API_PORT=8000
CAPFORGE_LOG_LEVEL=INFO

# =============================================================================
# SECURITY — CRITICAL FOR PRODUCTION
# CAPFORGE_DEV_MODE must be "false" or unset in production.
# Dev mode allows unauthenticated requests (for local development only).
# =============================================================================
CAPFORGE_DEV_MODE=false

# =============================================================================
# LLM SYNTHESIS — Configure one provider for real code generation
# Without this, synthesis falls back to template (non-functional) output.
# =============================================================================

# Option A: Google Gemini (recommended — fastest, cheapest)
CAPFORGE_LLM_PROVIDER=gemini
CAPFORGE_LLM_MODEL=gemini-1.5-flash
GEMINI_API_KEY=your-gemini-api-key-here

# Option B: OpenAI (uncomment and set provider to openai)
# CAPFORGE_LLM_PROVIDER=openai
# CAPFORGE_LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=your-openai-api-key-here

# LLM generation settings
CAPFORGE_LLM_TEMPERATURE=0.2
CAPFORGE_LLM_MAX_TOKENS=4096

# =============================================================================
# REDIS — Required for distributed event streaming and rate limit state
# Without Redis, events use in-memory fallback (not suitable for multi-instance).
# =============================================================================
# CAPFORGE_REDIS_URL=redis://:your-redis-password@redis:6379/0
CAPFORGE_REDIS_URL=

# =============================================================================
# RATE LIMITING
# =============================================================================
CAPFORGE_RATE_LIMIT_DEFAULT=100/minute
CAPFORGE_RATE_LIMIT_SYNTHESIS=10/minute
CAPFORGE_RATE_LIMIT_EXECUTE=60/minute

# =============================================================================
# SANDBOX & EXECUTION
# =============================================================================
CAPFORGE_SANDBOX_TIMEOUT=15.0
CAPFORGE_SANDBOX_SUBPROCESS=true
CAPFORGE_MAX_REPAIR_ITERATIONS=3
CAPFORGE_REQUIRE_REGRESSION=true

# =============================================================================
# GOVERNANCE
# =============================================================================
CAPFORGE_MAX_AUTO_PROMOTE_RISK=LOW
